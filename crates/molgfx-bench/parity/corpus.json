  "recipe_policy": {
    "scope": "Algorithm-specific maximum bounded sampling at fixed extent; effects and geometry are explicit, not assumed physically equivalent. Unbounded controls have no absolute maximum.",
    "molstar-raster": {
      "source_revision": "0efa4dfa5844a7ab879f905374b5813524383ba8",
      "sampling": "Single raster output, highest supported SMAA sensitivity/search: edgeThreshold=0.05 and maxSearchSteps=32. Multisampling belongs to the separate ImagePass recipe.",
      "source": "src/mol-canvas3d/passes/smaa.ts SmaaParams"
    },
    "molstar-imagepass": {
      "source_revision": "0efa4dfa5844a7ab879f905374b5813524383ba8",
      "sampling": "multiSample sampleLevel=5: maximum 32 jitter vectors, mode=on, no occlusion reuse; SMAA edgeThreshold=0.05/maxSearchSteps=32",
      "source": "src/mol-canvas3d/passes/multi-sample.ts MultiSampleParams/JitterVectors and smaa.ts SmaaParams"
    },
    "molstar-tracing": {
      "source_revision": "0efa4dfa5844a7ab879f905374b5813524383ba8",
      "sampling": "maxIterations=16: complete 65536 iterations; targetFps=0 disables FPS-driven downshift. Unmodified initial half-step/min-refine ramp is preserved and effective adjusted settings are captured.",
      "source": "src/mol-canvas3d/passes/illumination.ts IlluminationParams/getMaxIterations",
      "historical_diagnostic": "maxIterations=6 completes 64 iterations only; previous 64-iteration smoke is not maximum-quality evidence"
    },
    "pymol-raster": {
      "source_revision": "5e8bfca5a7f5dc4d5e7f84fa1d15af707cc86e69",
      "installed_source": "PyMOL 3.1.0 Scene.cpp ExtentGetUpscaleInfo matches local source",
      "sampling": "antialias=4 selects the highest supported draw supersampling: 4x per axis (16 uniform samples per output pixel). Values 2/3/4 map to the same raster factor. Runtime GL viewport limit is checked; reduction fails explicitly.",
      "geometry": "sphere_quality=4 is the source maximum. stick_quality=32 and cartoon_sampling=32 are fixed facet controls, not maxima: source declares no actual maximum for sticks and no bounded cartoon sampling domain.",
      "source": "layer1/Scene.cpp ExtentGetUpscaleInfo/SceneMakeSizedImage; layer1/SettingInfo.h MAX_SPHERE_QUALITY and stick_quality/cartoon_sampling",
      "historical_diagnostic": "Raster antialias=0 and 128x72 framebuffer smoke prove the adapter only, not maximum-quality performance"
    },
    "pymol-ray": {
      "source_revision": "5e8bfca5a7f5dc4d5e7f84fa1d15af707cc86e69",
      "sampling": "antialias=4: source-clamped highest 4x uniform oversampling per axis plus adaptive edge sampling; ray_trace_mode=0 normal ray transport",
      "geometry": "sphere_quality=4; fixed stick_quality=32/cartoon_sampling=32 are not absolute maxima of their unbounded domains",
      "source": "layer1/Ray.cpp RayRender; data/setting_help.csv antialias; layer1/SettingInfo.h",
      "historical_diagnostic": "Previous antialias=2 smoke is not maximum-quality evidence"
    },
    "prerequisites": [
      "Native standalone scalar-volume scenes and skew MRC rendering remain an explicit engine prerequisite, not an external skip or ray substitution",
      "Full corpus 1280x720 with 120 warmups and 1200 measured outputs is required for the requested performance acceptance; smaller/count-reduced smoke is diagnostic only"
    ]
  },
